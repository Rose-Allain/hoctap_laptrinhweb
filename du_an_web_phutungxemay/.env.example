# Sao chép thành .env rồi điền các giá trị cho môi trường của bạn.
PORT=3000
NODE_ENV=development
CORS_ORIGIN=

# Dùng DATABASE_URL (Neon/Render) hoặc nhóm PG* cho PostgreSQL local.
DATABASE_URL=
DB_SSL=false
PGHOST=localhost
PGPORT=5432
PGDATABASE=motorcycle_parts
PGUSER=postgres
PGPASSWORD=

# Khóa ký session (cookie rideform.sid). Bắt buộc khi NODE_ENV=production.
# Tạo khóa ngẫu nhiên bằng: npm run gen-secret
SESSION_SECRET=

# Chỉ dùng một lần để tạo tài khoản admin qua npm run create-admin.
# Đặt các giá trị trong phiên shell/môi trường riêng; xóa chúng sau khi tạo tài khoản.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
