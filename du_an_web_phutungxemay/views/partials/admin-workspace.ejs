        <div class="dialog-actions"><button class="admin-button admin-button--quiet" type="button" data-close-dialog="product-dialog">Hủy</button><button class="admin-button admin-button--primary" type="submit">Lưu sản phẩm <span aria-hidden="true">↗</span></button></div>
      </form>
