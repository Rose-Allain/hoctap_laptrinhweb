        <div class="invoice-form-layout">
          <div class="invoice-form-main">
            <section class="form-section"><div class="form-section__heading"><span>01</span><div><h3>Thông tin khách hàng</h3><p>Thông tin lưu trên hóa đơn</p></div></div><div class="form-grid"><label class="field field--wide">Tên khách hàng<input name="customer_name" required maxlength="200" /></label><label class="field">Email<input name="customer_email" type="email" maxlength="255" /></label><label class="field">Số điện thoại<input name="customer_phone" maxlength="30" /></label><label class="field field--wide">Địa chỉ thanh toán<textarea name="billing_address" rows="2"></textarea></label><label class="field field--wide">Địa chỉ giao hàng<textarea name="shipping_address" rows="2"></textarea></label><label class="field field--wide">Ghi chú<textarea name="notes" rows="2"></textarea></label></div></section>
            <section class="form-section"><div class="form-section__heading"><span>02</span><div><h3>Sản phẩm</h3><p>Giá được lấy tại thời điểm lập hóa đơn</p></div><button id="add-invoice-item" class="text-button" type="button">＋ Thêm dòng</button></div><div id="invoice-items-list" class="invoice-items-list"></div></section>
            <section id="payment-history-section" class="form-section payment-history-section" hidden><div class="form-section__heading"><span>04</span><div><h3>Lịch sử thanh toán</h3><p>Các khoản đã ghi nhận cho hóa đơn</p></div></div><div id="payment-history" class="payment-history"></div></section>
            <section id="status-history-section" class="form-section payment-history-section" hidden><div class="form-section__heading"><span>05</span><div><h3>Lịch sử trạng thái</h3><p>Các lần cập nhật hóa đơn</p></div></div><div id="status-history" class="payment-history"></div></section>
          </div>
          <aside class="invoice-form-aside"><div class="form-section__heading"><span>03</span><div><h3>Chi tiết hóa đơn</h3><p>Trạng thái và khoản thu</p></div></div><label class="field">Trạng thái<select name="status"><option value="draft">Bản nháp</option><option value="pending">Chờ xác nhận</option><option value="confirmed">Đã xác nhận</option><option value="processing">Đang xử lý</option><option value="shipped">Đang giao</option><option value="delivered">Đã giao</option><option value="cancelled">Đã hủy</option><option value="refunded">Đã hoàn tiền</option></select></label><label class="field">Chiết khấu (₫)<input name="discount_amount" type="number" min="0" step="1" value="0" /></label><label class="field">Thuế (₫)<input name="tax_amount" type="number" min="0" step="1" value="0" /></label><label class="field">Phí giao hàng (₫)<input name="shipping_fee" type="number" min="0" step="1" value="0" /></label><div class="invoice-totals"><div><span>Tạm tính</span><strong id="invoice-subtotal">0 ₫</strong></div><div><span>Chiết khấu</span><strong id="invoice-discount">− 0 ₫</strong></div><div class="invoice-totals__total"><span>Tổng thanh toán</span><strong id="invoice-total">0 ₫</strong></div></div><button id="record-payment-button" class="admin-button admin-button--quiet admin-button--wide" type="button" hidden>＋ Ghi nhận thanh toán</button></aside>
        </div>
        <div class="dialog-actions"><button class="admin-button admin-button--quiet" type="button" data-close-dialog="invoice-dialog">Hủy</button><button class="admin-button admin-button--primary" type="submit">Lưu hóa đơn <span aria-hidden="true">↗</span></button></div>
      </form>
    </dialog>

    <dialog id="payment-dialog" class="admin-dialog admin-dialog--small" aria-labelledby="payment-dialog-title">
      <form id="payment-form" class="dialog-form">
        <div class="dialog-heading"><div><p class="admin-eyebrow">PAYMENT ENTRY</p><h2 id="payment-dialog-title">Ghi nhận thanh toán</h2></div><button class="admin-icon-button" type="button" data-close-dialog="payment-dialog" aria-label="Đóng">×</button></div>
        <input type="hidden" name="invoice_id" />
        <p id="payment-invoice-label" class="payment-invoice-label"></p>
        <label class="field">Số tiền (₫)<input name="amount" type="number" min="1" step="1" required /></label>
        <label class="field">Phương thức<select name="method"><option value="cash">Tiền mặt</option><option value="bank_transfer">Chuyển khoản</option><option value="card">Thẻ</option><option value="e_wallet">Ví điện tử</option><option value="cod">Thu hộ (COD)</option><option value="other">Khác</option></select></label>
        <label class="field">Mã giao dịch<input name="transaction_code" maxlength="120" /></label>
        <label class="field">Ghi chú<textarea name="note" rows="2"></textarea></label>
        <div class="dialog-actions"><button class="admin-button admin-button--quiet" type="button" data-close-dialog="payment-dialog">Hủy</button><button class="admin-button admin-button--primary" type="submit">Lưu khoản thu</button></div>
      </form>
    </dialog>

    <div id="toast" class="admin-toast" role="status" aria-live="polite"></div>