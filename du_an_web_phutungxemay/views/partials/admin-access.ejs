<section id="access-screen" class="access-screen" aria-labelledby="access-title">
  <form id="access-form" class="access-card">
    <a class="admin-wordmark" href="/" aria-label="RIDEFORM trang chủ"><span class="admin-mark">R/F</span><span>RIDEFORM<small>ADMINISTRATION</small></span></a>
    <p class="admin-eyebrow">KHU VỰC QUẢN TRỊ</p>
    <h1 id="access-title">Chào mừng<br /><em>trở lại.</em></h1>
    <p class="access-copy">Đăng nhập bằng tài khoản quản trị đã được khởi tạo cho cửa hàng.</p>
    <label for="admin-email">Email quản trị</label>
    <input id="admin-email" name="email" type="email" autocomplete="username" required maxlength="255" />
    <label for="admin-password">Mật khẩu</label>
    <input id="admin-password" name="password" type="password" autocomplete="current-password" required maxlength="1024" />
    <button class="admin-button admin-button--primary admin-button--wide" type="submit">Đăng nhập <span aria-hidden="true">↗</span></button>
    <p id="access-error" class="access-error" role="alert" hidden></p>
    <a class="access-back" href="/">← Quay lại cửa hàng</a>
  </form>
  <div class="access-art" aria-hidden="true"><span>DETAILS<br />MAKE THE<br /><em>DIFFERENCE.</em></span><i></i><b></b></div>
</section>